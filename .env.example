# shared-coupon-redemption - server-side environment template.
# Copy to `.env` and fill in. `.env` is gitignored; this template is tracked.
# Every variable below is read on the server only and never sent to the browser.
#
# Some behaviour is decided by the deployment rather than by these variables -
# HTTPS for the session cookie, proxy headers for the failed-attempt throttle,
# and a response timeout above ~17 minutes for a full redemption run.
# See docs/deployment.md before deploying anywhere but localhost.

# Enables Mock_Mode: upstream calls are answered from fixtures/upstream/ instead
# of the real Upstream_API, and no network request is made.
# Enabled only when the trimmed value equals `true`, ignoring case.
# Absent, whitespace-only, or unrecognized => disabled (an unrecognized value
# logs a warning naming the variable and the rejected value, startup continues).
MOCK_MODE=false

# Base URL of the Upstream_API. The application posts to `${UPSTREAM_BASE_URL}/useCoupon`.
# Defaults to the value below when absent.
UPSTREAM_BASE_URL=https://event.withhive.com/ci/smon/evt_coupon

# Path of the JSON document holding the Member_Registry and the Redemption_History.
# Defaults to ./data/store.json when absent. The directory is gitignored.
# Put it on persistent storage and back it up; run one replica only, since this
# single file has a single writer.
DATA_FILE=./data/store.json

# Shared_Passphrase required to reach the application. Absent or whitespace-only
# => the Access_Gate is off, startup logs a prominent unauthenticated warning,
# and every request is admitted. Never logged and never returned in a response.
#
# WITH THIS UNSET THERE IS NO ACCESS GATE: anyone who can reach the port can read
# every Hive ID, read the whole history, and spend any coupon code irreversibly.
# Set a long random value for any deployment reachable by more than one machine.
# See docs/deployment.md section 4.
APP_PASSPHRASE=

# Key used to sign the session cookie issued after a correct passphrase.
# Absent => a fresh key is generated per process, so sessions do not survive a restart.
#
# The cookie is always issued `Secure`, so the application must be served over
# HTTPS (or `http://localhost`) for a session to be held at all.
# See docs/deployment.md section 1.
SESSION_SECRET=
