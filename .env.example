# shared-coupon-redemption - environment template.
# Copy to `.env` and fill in. `.env` is gitignored; this template is tracked.
# Every variable below is read on the server only and never sent to the browser,
# with one deliberate exception: `VITE_CLERK_PUBLISHABLE_KEY` is published to the
# browser bundle by design. See its entry below.
#
# Some behaviour is decided by the deployment rather than by these variables -
# HTTPS for the session cookie, proxy headers for the failed-attempt throttle,
# and a response timeout above ~17 minutes for a full redemption run.
# See docs/deployment.md before deploying anywhere but localhost.

# Enables Mock_Mode: upstream calls are answered from fixtures/upstream/ instead
# of the real Upstream_API, and no network request is made.
# Enabled only when the trimmed value equals `true`, ignoring case.
# Absent, whitespace-only, or unrecognized => disabled (an unrecognized value
# logs a warning naming the variable and the rejected value, startup continues).
MOCK_MODE=false

# Base URL of the Upstream_API. The application posts to `${UPSTREAM_BASE_URL}/useCoupon`.
# Defaults to the value below when absent.
UPSTREAM_BASE_URL=https://event.withhive.com/ci/smon/evt_coupon

# ---------------------------------------------------------------------------
# MongoDB - where the Member_Registry and the Redemption_History live
# ---------------------------------------------------------------------------

# Purpose: the MongoDB connection string naming the deployment, the credentials,
# and optionally the database. This is the only place the application learns
# where its data lives; the roster and the history are both stored there.
# Expected form: a MongoDB connection string, `mongodb://host:port/database` or
# `mongodb+srv://user:password@cluster.example.net/database`. Read once per
# process, with leading and trailing whitespace removed.
# Default: none. There is no fallback deployment.
#
# UNSET (or whitespace-only) => startup completes and logs exactly one warning
# naming this variable, no connection pool is opened, and every roster read,
# roster write, history read, and history write answers with an error message
# saying no database is configured. The application serves pages but stores
# nothing. A value that is present but does not parse behaves the same way, with
# a warning saying the value did not parse - the value itself is never logged.
MONGODB_URI=

# Purpose: the database name to use inside the deployment.
# Expected form: a MongoDB database name, no slashes, whitespace trimmed.
# Consulted only when MONGODB_URI carries no database path segment; a path
# segment in the URI always wins.
# Default: `sw-code`.
#
# UNSET => the database name is taken from the MONGODB_URI path segment, and
# when that is also empty, the name `sw-code` is used. Startup is unaffected.
MONGODB_DB_NAME=

# ---------------------------------------------------------------------------
# Clerk - Google sign-in and individual identity
# ---------------------------------------------------------------------------
# Google's OAuth client id and client secret are NOT set here. They are
# configured in the Clerk dashboard, on the Google social connection. This file
# holds only the two Clerk keys below.

# Purpose: identifies your Clerk instance to the Clerk SDK, in the browser and
# on the server, so the sign-in control and the session can work at all.
# Expected form: `pk_test_...` or `pk_live_...` as shown in the Clerk dashboard.
# Default: none.
#
# This key is PUBLISHED TO THE BROWSER BY DESIGN. The `VITE_` prefix is what
# does it, and that is what a publishable key is for - it is not a secret and
# needs no protection.
#
# UNSET (or whitespace-only) => startup completes and logs exactly one warning
# naming this variable, Google sign-in is unavailable, and the sign-in control
# is withheld from every page. An attempt to sign in answers with a message that
# names no key value.
VITE_CLERK_PUBLISHABLE_KEY=

# Purpose: authenticates this server to the Clerk Backend API when it reads the
# signed-in person's email address and display name.
# Expected form: `sk_test_...` or `sk_live_...` as shown in the Clerk dashboard.
# Default: none.
#
# SERVER-ONLY AND SECRET. It is never logged, never returned in a response body,
# and never delivered to the browser. Do not give it a `VITE_` prefix, which
# would publish it to the bundle. Rotate it in the Clerk dashboard if it leaks.
#
# UNSET (or whitespace-only) => startup completes and logs exactly one warning
# naming this variable, Google sign-in is unavailable, and the sign-in control
# is withheld from every page.
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Authorization
# ---------------------------------------------------------------------------

# Purpose: the Admin_Allowlist. An account whose Google email address appears
# here holds the Admin_Role and can reach /admin; every other account holds the
# Member_Role. The list is re-read against each account as its identity is
# refreshed, so editing it takes effect without a redeploy.
# Expected form: email addresses separated by commas, for example
# `owner@example.com, second.admin@example.com`. Surrounding whitespace on each
# address is removed. Comparison is CASE-INSENSITIVE: addresses here and the
# address Google asserts are both lower-cased before matching, so
# `Owner@Example.com` and `owner@example.com` are the same entry. Entries with
# no `@`, entries longer than 254 characters, and empty entries are dropped;
# duplicates keep their first occurrence; at most the first 50 entries are used.
# Default: none - an empty allowlist.
#
# UNSET (or whitespace-only) => startup completes and logs exactly one warning
# naming this variable, every stored account gets the Member_Role, and /admin is
# reachable by nobody. Nothing else is restricted: signing in and redeeming
# coupons still work.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Legacy data
# ---------------------------------------------------------------------------

# Purpose: the source of the one-time Data_Import. On the first startup against
# an empty database, the roster entries and history records in this JSON
# document are copied into MongoDB so nothing from the file-backed version is
# lost. It is READ ONCE AND NEVER WRITTEN: MongoDB is the only store the running
# application writes to, and the file is left byte-identical and in place.
# Expected form: a filesystem path to a JSON document in the store shape.
# Defaults to ./data/store.json when absent. The directory is gitignored.
#
# The import is due only while both collections are empty, so once it has run
# the file is never consulted again and can be archived. Absent, unreadable
# within 5 seconds, or unparsable => one warning naming the path and the
# condition, startup continues with two empty collections.
DATA_FILE=./data/store.json

# ---------------------------------------------------------------------------
# Shared passphrase perimeter
# ---------------------------------------------------------------------------

# Shared_Passphrase required to reach the application. Absent or whitespace-only
# => the Access_Gate is off, startup logs a prominent unauthenticated warning,
# and every request is admitted. Never logged and never returned in a response.
#
# WITH THIS UNSET THERE IS NO ACCESS GATE: anyone who can reach the port can read
# every Hive ID, read the whole history, and spend any coupon code irreversibly.
# Set a long random value for any deployment reachable by more than one machine.
# See docs/deployment.md section 4.
APP_PASSPHRASE=

# Key used to sign the session cookie issued after a correct passphrase.
# Absent => a fresh key is generated per process, so sessions do not survive a restart.
#
# The cookie is always issued `Secure`, so the application must be served over
# HTTPS (or `http://localhost`) for a session to be held at all.
# See docs/deployment.md section 1.
SESSION_SECRET=
